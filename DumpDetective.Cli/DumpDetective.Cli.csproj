<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DumpDetective.Commands\DumpDetective.Commands.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DumpDetective.Cli</RootNamespace>
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Major.Minor are set here; Patch auto-increments on each build (days since 2000-01-01). -->
    <!-- Disable deterministic builds so the * wildcard is evaluated at build time.            -->
    <AssemblyVersion>4.0.0.*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <NoWarn>$(NoWarn);7035</NoWarn>
	<PackAsTool>true</PackAsTool>
    <ToolCommandName>DumpDetective</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  <IncludeSymbols>true</IncludeSymbols>
  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageVersion>4.0.0</PackageVersion>
    <Version>4.0.0</Version>
    <PackageId>DumpDetective.Cli</PackageId>
    <Description>CLI tool for analysing .NET memory dumps (.dmp / .mdmp), .nettrace/.etl files, and Chrome DevTools performance traces. Heap stats, trend analysis, deadlock detection, browser CPU/memory/jank analysis, and more.</Description>
    <Authors>RohitM-IN</Authors>
    <PackageTags>
		dotnet-tool;dotnet-dump;dotnettrace;clrmd;
		memory-analysis;dump-analysis;heap-analysis;gc-analysis;
		performance-analysis;profiling;diagnostics-tools;
		debugging-tools;postmortem-debugging;crash-analysis;
		deadlock-detection;thread-analysis;async-debugging;
		runtime-analysis;eventpipe;etw;
		memory-leak-detection;allocation-analysis;threadpool-analysis;
		windbg;diagnostics;
		chrome-devtools;web-performance;browser-profiling;cpu-hotspots
	</PackageTags>
    <PackageProjectUrl>https://github.com/Azooid/DumpDetective</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Azooid/DumpDetective</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />

    <!-- dotnet tool pack can emit win-x64 PDBs into snupkg; include matching DLLs in nupkg -->
    <None Include="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\win-x64\linked\DumpDetective.*.dll"
          Pack="true"
          PackagePath="tools\$(TargetFramework)\any\win-x64\" />

    <!--
      Preserve the entire public API surfaces of Core and Reporting when the
      trimmer is enabled (PublishTrimmed=true).  Plugins reference these types
      at runtime via AssemblyLoadContext; without this descriptor the trimmer
      removes them because it cannot see the runtime references.
    -->
    <TrimmerRootDescriptor Include="PluginRoots.xml" />
  </ItemGroup>

  <!--
    Plugins are third-party — strip the entire plugins/ folder from the publish
    output before the tool pack picks it up.  This runs after publish completes
    so the local dev-test deployment (done by DeployPlugin in each plugin csproj)
    is unaffected; only the nupkg is clean.
  -->
  <Target Name="ExcludePluginsFromPack" AfterTargets="Publish" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <!-- Default publish dir (tools/net10.0/any/ in nupkg) -->
      <_PublishPluginFiles Include="$(PublishDir)plugins\**\*" />
      <!-- win-x64 publish subdir (tools/net10.0/any/win-x64/ in nupkg) -->
      <_PublishPluginFiles Include="$(PublishDir)win-x64\plugins\**\*" />
    </ItemGroup>
    <Delete Files="@(_PublishPluginFiles)" />
    <RemoveDir Directories="$(PublishDir)plugins;$(PublishDir)win-x64\plugins" />
  </Target>

</Project>
  