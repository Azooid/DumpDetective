<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DumpDetective.ScenarioHost</AssemblyName>
    <RootNamespace>DumpDetective.ScenarioHost</RootNamespace>
    <!-- Allow unsafe code needed by GCHandle pinning in some scenarios -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Long timeout for GC scenarios that wait for finalizer thread signals -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.*" />
  </ItemGroup>

</Project>
