<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DumpDetective.DiagnosticScenarios</AssemblyName>
    <RootNamespace>DumpDetective.DiagnosticScenarios</RootNamespace>
    <!-- Allow unsafe code needed by GCHandle pinning in some scenarios -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Long timeout for GC scenarios that wait for finalizer thread signals -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.*" />
    <PackageReference Include="xunit.assert" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DumpDetective.Core\DumpDetective.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
